# Complete ASR configuration template.
# Copy a profile from config/profiles/ for common setups.

ASR_BEARER_TOKEN=change-me
ASR_MODEL_SIZE=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_CPU_THREADS=4
ASR_NUM_WORKERS=1

ASR_WHISPER_CUDA_VISIBLE_DEVICES=
ASR_WHISPER_KEEP_WARM=0
# Optional resident Qwen3-ASR engine selected by multipart model=qwen3-asr-1.7b.
# Install qwen-asr and CUDA-compatible PyTorch in a separate Python environment.
ASR_QWEN_ENABLED=0
ASR_QWEN_MODEL_ID=qwen3-asr-1.7b
ASR_QWEN_CHECKPOINT=Qwen/Qwen3-ASR-1.7B
ASR_QWEN_PYTHON=/opt/asr-qwen/venv/bin/python
ASR_QWEN_CUDA_VISIBLE_DEVICES=
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=0
ASR_VAD_MIN_SILENCE_MS=500

ASR_LISTEN_HOST=127.0.0.1
ASR_LISTEN_PORT=9000
ASR_MAX_CONCURRENCY=1
ASR_MAX_FILE_SIZE=26214400
ASR_REQUEST_TIMEOUT=300
ASR_BUSY_WAIT_TIMEOUT=600
ASR_MODEL_CACHE_DIR=/opt/portable-asr/models

ASR_POSTPROCESS_ENABLED=0
ASR_POSTPROCESS_PROVIDER=local-llama
ASR_POSTPROCESS_BASE_URL=http://127.0.0.1:9100/v1
ASR_POSTPROCESS_MODEL=example-cleanup-model
ASR_POSTPROCESS_TIMEOUT=180
ASR_POSTPROCESS_CLI=/opt/asr-llm/bin/llama-cli
ASR_POSTPROCESS_CONTEXT=8192
ASR_POSTPROCESS_CACHE_DIR=/opt/asr-llm/hf-cache
ASR_POSTPROCESS_LIBRARY_PATH=/opt/asr-llm/bin
ASR_AUDIO_POSTPROCESS_REQUIRED=0

ASR_POST_WHISPER_GPU_SETTLE_SECONDS=0
ASR_STOP_LLM_FOR_TRANSCRIPTION=0
ASR_LLM_START_RETRIES=2
ASR_LLM_CUDA_VISIBLE_DEVICES=
ASR_LLM_DEVICE=
ASR_LLM_SERVER_HOST=127.0.0.1
ASR_LLM_SERVER_PORT=9100
ASR_LLM_IDLE_TIMEOUT=3600
ASR_LLM_WATCH_INTERVAL=3
ASR_LLM_START_TIMEOUT=180
ASR_LLM_BUSY_WAIT_TIMEOUT=600
ASR_LLM_LOG_FILE=/opt/portable-asr/llama-server.log
ASR_LLM_PID_FILE=/opt/portable-asr/llama-server.pid
ASR_LLM_CACHE_REUSE=256
ASR_LLM_SERVER_BIN=/opt/asr-llm/bin/llama-server
ASR_GPU_WATCH_ENABLED=0
ASR_GPU_WATCH_PROCESS_PATTERNS=ffmpeg

HF_HOME=/opt/portable-asr/hf-cache
HUGGINGFACE_HUB_CACHE=/opt/portable-asr/hf-cache/hub
HF_HUB_DISABLE_PROGRESS_BARS=1
